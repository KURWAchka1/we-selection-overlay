     private static final int ENVELOPE_VERSION = 1;
 
     public enum Direction { TO_SERVER, TO_CLIENT }
+    public enum RequestKind { UNKNOWN, HELLO, SELECTION_READ, EDIT_READ, EDIT_COMMIT }
 
     private BridgeCodec() { }
 
+    /** Scheduling hint only: does not validate the body or authorize processing. */
+    public static RequestKind peekRequestKind(byte[] frame) {
+        if (frame == null || frame.length < MIN_FRAME_BYTES || frame.length > MAX_FRAME_BYTES) return RequestKind.UNKNOWN;
+        ByteBuffer in = ByteBuffer.wrap(frame);
+        if (in.getInt() != MAGIC || Byte.toUnsignedInt(in.get()) != ENVELOPE_VERSION) return RequestKind.UNKNOWN;
+        return switch (Byte.toUnsignedInt(in.get())) {
+            case 1 -> frame.length == 30 ? RequestKind.HELLO : RequestKind.UNKNOWN;
+            case 3 -> frame.length == 30 ? RequestKind.SELECTION_READ : RequestKind.UNKNOWN;
+            case 6 -> frame.length == 30 ? RequestKind.EDIT_READ : RequestKind.UNKNOWN;
+            case 8 -> frame.length == 70 ? RequestKind.EDIT_COMMIT : RequestKind.UNKNOWN;
+            default -> RequestKind.UNKNOWN;
+        };
+    }
+
     public static byte[] encode(BridgeMessage message) {
         ByteBuffer out = ByteBuffer.allocate(encodedSize(message));
         out.putInt(MAGIC).put((byte) ENVELOPE_VERSION);
