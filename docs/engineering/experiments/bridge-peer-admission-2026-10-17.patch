+    @Test void knownPeerCostIsReservedAfterCheapVisitsWithoutSpendingDeferredQuota() {
+        for (long start : new long[] { 1, Long.MAX_VALUE - 300_000 }) {
+            for (boolean publicationCost : new boolean[] { false, true }) {
+                time.set(start);
+                var sourceReads = new AtomicLong();
+                BridgeServer target = new BridgeServer(new BridgeServer.Host() {
+                    public boolean mayReadSelection(UUID id) { time.addAndGet(50_000); return true; }
+                    public SelectionState readSelection(UUID id) {
+                        sourceReads.incrementAndGet();
+                        if (!publicationCost) time.addAndGet(200_000);
+                        return new SelectionState(SelectionStatus.READY, new Bounds(0, 0, 0, 1, 1, 1), -64, 319, 7);
+                    }
+                }, new BridgeServer.Limits(32, 1, 8, 100, 100), time::get, UUID::randomUUID);
+                var order = new ArrayList<UUID>();
+                var epoch = new AtomicReference<UUID>();
+                java.util.function.BiConsumer<UUID, byte[]> send = (id, frame) -> {
+                    BridgeMessage message = BridgeCodec.decode(frame, BridgeCodec.Direction.TO_CLIENT);
+                    if (message instanceof Welcome welcome && id.equals(player)) epoch.set(welcome.epoch());
+                    if (message instanceof SelectionReply && publicationCost) time.addAndGet(200_000);
+                    order.add(id);
+                };
+                assertTrue(target.enqueue(player, BridgeCodec.encode(hello(1))));
+                assertEquals(1, target.drain(send));
+                assertTrue(target.enqueue(player, BridgeCodec.encode(new SelectionRequest(epoch.get(), 1))));
+                assertEquals(1, target.drain(send));
+                order.clear();
+                for (int i = 0; i < 5; i++) assertTrue(target.enqueue(new UUID(5, i), BridgeCodec.encode(hello(i))));
+                assertTrue(target.enqueue(player, BridgeCodec.encode(new SelectionRequest(epoch.get(), 2))));
+                assertEquals(5, target.drain(send), "Known 300us read does not fit after 250us of cheap visits");
+                for (int i = 0; i < 5; i++) assertEquals(new UUID(5, i), order.get(i));
+                assertEquals(1, target.pendingCount()); assertEquals(7, target.metrics().admitted());
+                assertTrue(target.queueMetrics().maxSliceNanos() <= 500_000);
+                assertEquals(1, target.drain(send), "Deferred visit still owns the last aggregate token");
+                assertEquals(player, order.getLast()); assertEquals(2, sourceReads.get());
+                assertEquals(8, target.metrics().admitted()); assertEquals(0, target.metrics().throttled());
+                assertEquals(0, target.pendingCount()); assertEquals(0, target.queueMetrics().expired());
+            }
+        }
+    }
