+            target.drain((id, frame) -> tokens.put(id, ((Welcome) BridgeCodec.decode(frame, BridgeCodec.Direction.TO_CLIENT)).epoch()));
+        }
+        target.enqueue(player, BridgeCodec.encode(new SelectionRequest(tokens.get(player), 1)));
