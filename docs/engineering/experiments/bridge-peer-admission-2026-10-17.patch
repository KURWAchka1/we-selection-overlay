+            for (int i = 0; i < 5; i++) target.enqueue(new UUID(5, i), BridgeCodec.encode(hello(i)));
+            target.enqueue(player, BridgeCodec.encode(hello(2 + round)));
+            assertEquals(round == 0 ? 5 : 6, target.drain((id, frame) -> { }));
